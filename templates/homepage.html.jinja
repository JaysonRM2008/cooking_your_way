<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
  <title>HomePage</title>
</head>

<body class="bg-gray-100 min-h-screen">

  {% include "components/navbar.html.jinja" %}

  <!-- Page Content  -->
  <main class="ml-64 px-4 md:px-8 py-8">

    <!-- HERO -->
    <section class="max-w-6xl mx-auto">
      <div class="relative overflow-hidden rounded-2xl shadow-xl border border-gray-200">
        <!-- gif -->
        <img
          src="/static/product/2620043-uhd_3840_2160_25fps-ezgif.com-speed.gif"
          alt="cooking"
          class="w-full h-[260px] md:h-[380px] object-cover"
        />

        <!-- Dark overlay -->
        <div class="absolute inset-0 bg-black/45"></div>

        <!-- Hero content -->
        <div class="absolute inset-0 flex flex-col items-center justify-center text-center px-4">
          

          <h1 class="mt-4 text-4xl md:text-5xl font-extrabold text-white drop-shadow">
            Welcome to CookingYour Way
          </h1>

<p class="mt-3 text-white/90 text-base md:text-lg max-w-2xl">
  Too lazy to shop? Out of meal ideas? <span class="font-semibold text-white">CookingYour Way</span> has you covered.
</p>

          <div class="mt-6 flex flex-wrap gap-3 justify-center">
            <a href="/browse"
               class="px-6 py-3 rounded-full bg-yellow-500 text-white font-bold shadow hover:bg-yellow-600 transition hover:scale-105">
              Shop Now
            </a>
            <a href="/browse"
               class="px-6 py-3 rounded-full bg-white/15 text-white font-bold border border-white/30
                      hover:bg-white/25 transition">
              Explore Categories
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- FEATURED STRIP -->
    <section class="max-w-6xl mx-auto mt-10">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">

        <div class="bg-white rounded-2xl shadow p-6 border border-gray-200">
          <div class="text-2xl">🔥</div>
          <h2 class="mt-3 text-xl font-bold">Hot Deals</h2>
          <p class="mt-1 text-gray-600">Limited-time savings on top picks.</p>
          <a href="/browse" class="inline-block mt-4 text-blue-600 font-semibold hover:underline">Shop deals →</a>
        </div>

        <div class="bg-white rounded-2xl shadow p-6 border border-gray-200">
          <div class="text-2xl">🍳</div>
          <h2 class="mt-3 text-xl font-bold">Quick Recipes</h2>
          <p class="mt-1 text-gray-600">Fast, tasty meals you can make today.</p>
          <a href="/browse" class="inline-block mt-4 text-blue-600 font-semibold hover:underline">Browse recipes →</a>
        </div>

        <div class="bg-white rounded-2xl shadow p-6 border border-gray-200">
          <div class="text-2xl">🛒</div>
          <h2 class="mt-3 text-xl font-bold">Best Sellers</h2>
          <p class="mt-1 text-gray-600">Customer favorites, always in style.</p>
          <a href="/browse" class="inline-block mt-4 text-blue-600 font-semibold hover:underline">See best sellers →</a>
        </div>

      </div>
    </section>

    <!-- PREVIEW GRID (static placeholder-->
    <section class="max-w-6xl mx-auto mt-10">
      <div class="flex items-center justify-between mb-4">
        <h2 class="text-2xl font-extrabold text-gray-800">Featured Picks</h2>
        <a href="/browse" class="text-blue-600 font-semibold hover:underline">View all →</a>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        <!-- Card -->
        <div class="bg-white rounded-2xl shadow border border-gray-200 overflow-hidden hover:shadow-lg transition">
          <div class="h-40 bg-gray-200"></div>
          <div class="p-4">
            <div class="font-bold">Featured Item</div>
            <div class="text-gray-600 text-sm mt-1">Perfect for your next meal.</div>
            <div class="mt-3 font-extrabold">$9.99</div>
            <a href="/browse" class="block mt-4 text-center bg-gray-900 text-white font-bold py-2 rounded-lg hover:bg-gray-800 transition">
              Explore
            </a>
          </div>
        </div>

        <div class="bg-white rounded-2xl shadow border border-gray-200 overflow-hidden hover:shadow-lg transition">
          <div class="h-40 bg-gray-200"></div>
          <div class="p-4">
            <div class="font-bold">Featured Item</div>
            <div class="text-gray-600 text-sm mt-1">A fan favorite pick.</div>
            <div class="mt-3 font-extrabold">$12.99</div>
            <a href="/browse" class="block mt-4 text-center bg-gray-900 text-white font-bold py-2 rounded-lg hover:bg-gray-800 transition">
              Explore
            </a>
          </div>
        </div>

        <div class="bg-white rounded-2xl shadow border border-gray-200 overflow-hidden hover:shadow-lg transition">
          <div class="h-40 bg-gray-200"></div>
          <div class="p-4">
            <div class="font-bold">Featured Item</div>
            <div class="text-gray-600 text-sm mt-1">Upgrade your kitchen.</div>
            <div class="mt-3 font-extrabold">$19.99</div>
            <a href="/browse" class="block mt-4 text-center bg-gray-900 text-white font-bold py-2 rounded-lg hover:bg-gray-800 transition">
              Explore
            </a>
          </div>
        </div>

        <div class="bg-white rounded-2xl shadow border border-gray-200 overflow-hidden hover:shadow-lg transition">
          <div class="h-40 bg-gray-200"></div>
          <div class="p-4">
            <div class="font-bold">Featured Item</div>
            <div class="text-gray-600 text-sm mt-1">New and trending.</div>
            <div class="mt-3 font-extrabold">$7.99</div>
            <a href="/browse" class="block mt-4 text-center bg-gray-900 text-white font-bold py-2 rounded-lg hover:bg-gray-800 transition">
              Explore
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- FOOTER -->
    <footer class="max-w-6xl mx-auto mt-12 pb-10 text-center text-gray-500">
      <p class="font-semibold">CookingYour Way</p>
      <p class="text-sm">Cook smarter. Eat better. Feel premium.</p>
    </footer>

  </main>

</body>
</html>
