<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
  <title>Browse</title>
</head>

<body class="bg-gray-100 min-h-screen">

  {% include "components/navbar.html.jinja" %}

 
  <!-- Page Content  -->
  <main class="ml-64 px-4 md:px-8 py-8">

    <!-- Product Grid -->
    <section id="products" class="max-w-6xl mx-auto mt-10">
      <div class="flex items-end justify-between mb-5">
        <div>
          <h2 class="text-2xl font-extrabold text-gray-900">Products</h2>
          <p class="text-gray-600">Click a product to view details.</p>
        </div>
        <a href="/cart" class="text-blue-600 font-semibold hover:underline">Go to Cart →</a>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">

        {% for x in products %}
        <a href="/product/{{ x['ID'] }}"
           class="group bg-white rounded-2xl shadow border border-gray-200 overflow-hidden hover:shadow-xl transition">

          <!-- Image -->
          <div class="h-48 bg-gray-50 border-b flex items-center justify-center overflow-hidden">
            <img
              src="{{ x['Image'] }}"
              alt="{{ x['Name'] }}"
              class="max-h-full max-w-full object-contain transition group-hover:scale-105"
            />
          </div>

          <!-- Content -->
          <div class="p-5">
            <div class="flex items-start justify-between gap-3">
              <h3 class="font-bold text-lg text-gray-900 group-hover:text-blue-600 transition">
                {{ x['Name'] }}
              </h3>

              <div class="shrink-0 inline-flex items-center px-3 py-1.5 rounded-full bg-black text-white font-extrabold">
                ${{ x['Price'] }}
              </div>
            </div>

            <div class="mt-4 flex items-center justify-between">
              <span class="text-sm text-gray-500">View details</span>

              <span class="inline-flex items-center px-4 py-2 rounded-full bg-yellow-500 text-white font-bold
                           hover:bg-yellow-600 transition">
                Shop
              </span>
            </div>
          </div>

        </a>
        {% endfor %}

      </div>
    </section>

    <!-- Footer -->
    <footer class="max-w-6xl mx-auto mt-12 pb-10 text-center text-gray-500">
      <p class="font-semibold">Chef Premiums</p>
      <p class="text-sm">Cook smarter. Eat better. Feel premium.</p>
    </footer>

  </main>

</body>
</html>
