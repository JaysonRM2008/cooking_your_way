<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
  <title>404 | Page Not Found</title>
</head>

<body class="bg-gray-100 min-h-screen flex items-center justify-center">

  <div class="max-w-xl text-center px-6">
    
    <!-- Big 404 -->
    <h1 class="text-7xl md:text-8xl font-extrabold text-gray-900">
      404
    </h1>

    <!-- Message -->
    <p class="mt-4 text-xl font-semibold text-gray-800">
      Oops! This page doesn’t exist.
    </p>

    <p class="mt-2 text-gray-600">
      Looks like this recipe didn’t turn out. Let’s get you back to something tasty.
    </p>

    <!-- Buttons -->
    <div class="mt-6 flex flex-wrap gap-3 justify-center">
      <a href="/"
         class="px-6 py-3 rounded-full bg-yellow-500 text-white font-bold shadow hover:bg-yellow-600 transition hover:scale-105">
        Go Home
      </a>

      <a href="/browse"
         class="px-6 py-3 rounded-full bg-gray-900 text-white font-bold shadow hover:bg-gray-800 transition">
        Browse Meals
      </a>
    </div>

    <!-- Fun detail -->
    <div class="mt-8 text-sm text-gray-400">
      Error: Page not found 🍳
    </div>

  </div>

</body>
</html>
